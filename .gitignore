# ==========================================================
# 白名单模式：默认忽略全部文件，只发布明确允许的项目文件
# 修改放行规则时，请同步更新下方的放行清单
# ==========================================================

*

# 允许进入目录
!*/

# ==========================================================
# 根目录必要文件
# ==========================================================

!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE.txt
!/VERSION
!/requirements.txt
!/server.py
!/client.py
!/build_client.bat
!/run.bat
!/run.sh

# ==========================================================
# 源代码
# ==========================================================

!app/**/*.py
!tools/**/*.py

# 清理入口的一键包装（双击即用），其余 .bat 仍不发布
!tools/scratch_clean.bat

!web/**/*.js
!web/**/*.html
!web/**/*.css
!web/favicon.png

# ==========================================================
# 文档
# ==========================================================

!docs/**/*.md

# 暂不发布：知识库文本格式规范（内部口径文档，转正式后再放行）
docs/知识库文本格式规范.md

# ==========================================================
# 以下均为用户数据 / 本地运行数据，永不发布
# ==========================================================

config/
Workspace/
.update_backups/
build/

# 操作临时数据空间（本地专用：永不提交、不入同步、7 天保留自动清理）
# 细则见 .scratch/README.md；清理入口 tools/scratch_clean.py
/.scratch/

# 临时产物基名约定（无前导斜杠 → 任意目录生效，堵住 web/**/*.html 之类放行规则）
_verify_*
_preview_*
_timing_*
